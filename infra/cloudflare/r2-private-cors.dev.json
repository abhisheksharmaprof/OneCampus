{
  "rules": [
    {
      "allowed": {
        "origins": [
          "http://localhost:5173",
          "http://localhost:5174",
          "http://localhost:5175"
        ],
        "methods": ["GET", "HEAD", "PUT"],
        "headers": ["Content-Type", "Content-MD5", "If-None-Match"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
