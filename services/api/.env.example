# CampusOne API environment
# Copy to .env and replace placeholders. Never commit .env.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Railway PostgreSQL: paste the public/private DATABASE_URL supplied by Railway.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=true

# Set true only for local bootstrap/tests when PostgreSQL is unavailable.
DJANGO_USE_SQLITE=true

# Railway Redis URL, normally redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:PASSWORD@HOST:PORT
CELERY_TASK_ALWAYS_EAGER=true

# JWT access lifetime; refresh tokens have a fixed one-day lifetime.
JWT_ACCESS_MINUTES=15
IDENTITY_LOGIN_RATE=10/minute
IDENTITY_REFRESH_RATE=30/minute
PASSWORD_RESET_RATE=5/hour
PASSWORD_RESET_URL=http://localhost:5173/login
INSTITUTE_ONBOARDING_RATE=5/hour

# Observability and integrations (optional during local development)
SENTRY_DSN=
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
EMAIL_URL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL="HostelDesk <no-reply@campusone.local>"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
PASSWORD_RESET_URL=http://localhost:5175/login
WHATSAPP_PROVIDER_API_KEY=

# Azure Blob Storage (keep containers private; prefer managed identity in production)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net
AZURE_STORAGE_PROFILE_CONTAINER=profile-images
AZURE_STORAGE_DOCUMENT_CONTAINER=documents
AZURE_STORAGE_INSTITUTE_CONTAINER=institute-assets
AZURE_STORAGE_TEMP_CONTAINER=temporary-uploads
AZURE_STORAGE_SAS_MINUTES=10
AZURE_STORAGE_REQUIRE_SCAN=false

# Azure Blob Storage. Prefer account URL + managed identity in production;
# use a connection string only for local development or explicitly managed secrets.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=campusone-files
AZURE_STORAGE_SAS_EXPIRY_MINUTES=15
AZURE_STORAGE_UPLOAD_EXPIRY_MINUTES=30
AZURE_STORAGE_MAX_UPLOAD_BYTES=104857600
