# CampusOne API environment
# Copy to .env and replace placeholders. Never commit .env.
DJANGO_ENV=development
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_APP_DOMAIN=snifply.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# PostgreSQL. In Railway, use ${{Postgres.DATABASE_URL}} as a service variable.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_CONN_MAX_AGE=60
DATABASE_SSL_REQUIRE=true
DATABASE_CONNECT_TIMEOUT=10

# CampusOne uses PostgreSQL for app runs. Do not enable SQLite for local app runs.
DJANGO_USE_SQLITE=false

# Railway Redis URL, normally redis://default:PASSWORD@HOST:PORT
REDIS_URL=redis://default:PASSWORD@HOST:PORT
CELERY_TASK_ALWAYS_EAGER=true

# JWT access lifetime; refresh tokens have a fixed one-day lifetime.
JWT_ACCESS_MINUTES=15
IDENTITY_LOGIN_RATE=10/minute
IDENTITY_REFRESH_RATE=30/minute
PASSWORD_RESET_RATE=5/hour
PASSWORD_RESET_URL=http://localhost:5173/login
INSTITUTE_ONBOARDING_RATE=5/hour

# Local API request log. Logs are JSON lines in services/api/logs/api.log and
# are cleared automatically whenever the API server starts.
# Rotation keeps a long-running server's local disk bounded.
API_LOG_MAX_BYTES=10485760
API_LOG_BACKUP_COUNT=5

# Observability and integrations (optional during local development)
SENTRY_DSN=
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=
EMAIL_URL=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL="HostelDesk <no-reply@campusone.local>"
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
PASSWORD_RESET_URL=http://localhost:5175/login
WHATSAPP_PROVIDER_API_KEY=

# Azure Blob Storage (keep containers private; prefer managed identity in production)
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ENDPOINT_SUFFIX=core.windows.net
AZURE_STORAGE_PROFILE_CONTAINER=profile-images
AZURE_STORAGE_DOCUMENT_CONTAINER=documents
AZURE_STORAGE_INSTITUTE_CONTAINER=institute-assets
AZURE_STORAGE_TEMP_CONTAINER=temporary-uploads
AZURE_STORAGE_SAS_MINUTES=10
AZURE_STORAGE_REQUIRE_SCAN=false

# Azure Blob Storage. Prefer account URL + managed identity in production;
# use a connection string only for local development or explicitly managed secrets.
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=campusone-files
AZURE_STORAGE_SAS_EXPIRY_MINUTES=15
AZURE_STORAGE_UPLOAD_EXPIRY_MINUTES=30
AZURE_STORAGE_MAX_UPLOAD_BYTES=104857600

# Cloudflare R2 (target provider). Create separate credentials for S3 object
# access and Cloudflare account administration. Never expose either to a browser.
FILE_STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=replace-with-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# Optional override; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_REGION=auto
R2_PRIVATE_BUCKET=campusone-private-dev
R2_PUBLIC_BUCKET=campusone-public-dev
# Production custom domain for explicitly approved public branding only.
R2_PUBLIC_BASE_URL=

# Short-lived bearer grants and bounded provider calls.
R2_UPLOAD_TTL_SECONDS=900
R2_DOWNLOAD_TTL_SECONDS=300
R2_STAGING_DELETE_BUFFER_SECONDS=300
R2_CONNECT_TIMEOUT_SECONDS=5
R2_READ_TIMEOUT_SECONDS=15
R2_MAX_ATTEMPTS=4
R2_MAX_POOL_CONNECTIONS=20

# Server-authoritative file policy and lifecycle.
FILE_STORAGE_RETENTION_DAYS=30
FILE_STORAGE_MAX_PROFILE_BYTES=5242880
FILE_STORAGE_MAX_BRANDING_BYTES=10485760
FILE_STORAGE_MAX_DOCUMENT_BYTES=26214400
FILE_STORAGE_PREVIEW_MAX_PIXELS=40000000
FILE_STORAGE_THUMBNAIL_SIZE=150
FILE_STORAGE_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Wrangler/bucket administration and exact-URL CDN purge. This token is
# separate from the R2 S3 credentials and should have only the required scope.
CLOUDFLARE_API_TOKEN=replace-with-scoped-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_ZONE_ID=
